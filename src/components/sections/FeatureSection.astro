<section class={styles.feature} id="features" aria-labelledby="feature-title">
  <header class={styles.sectionHeading}>
    <span class={styles.headingEnglish} aria-hidden="true">feature</span>
    <h2 class={styles.headingJapanese} id="feature-title">ふもと旅館の特徴</h2>
  </header>

  {
    featureItems.map((item) => (
      <article class={`${styles.featureItem} ${item.className}`}>
        <div class={styles.featureVisual}>
          <div class={styles.backgroundPhoto} aria-hidden="true">
            <Image src={item.background} alt="" width={500} height={700} />
          </div>
          <h3 class={styles.itemTitle}>{item.title}</h3>
          {item.photoSlots.map((slot) => (
            <div
              class={`${styles.photoSlot} ${slot.className}`}
              aria-hidden="true"
            >
              {slot.photos.map((photo) => (
                <Image
                  src={photo}
                  alt=""
                  width={slot.width}
                  height={slot.height}
                />
              ))}
            </div>
          ))}
        </div>
        <div class={styles.featureCopy}>
          <p class={styles.featureLead}>{item.lead}</p>
          <div class={styles.featureDescription}>
            {item.description.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </article>
    ))
  }
</section>
